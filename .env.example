# Copy to .env at this repo root and fill in. Never commit .env.

# Required for POST /ask (RAG + OpenAI)
OPENAI_API_KEY=

# Optional: proxy or OpenAI-compatible API (e.g. Azure-style gateway)
# OPENAI_BASE_URL=

# Chat model for RAG answers (default: gpt-4o-mini)
# LAWASSIST_OPENAI_MODEL=gpt-4o-mini

# Streamlit UI: FastAPI base URL (default used if unset in app)
# LAWASSIST_API_BASE=http://127.0.0.1:8000
